# Noesis.io Health  - Environment Configuration
# © 2026 Athena Core Technologies, Inc.
# NEVER commit actual values. Copy this file to .env and fill in real values.

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ── AUTHENTICATION ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_use_64_byte_random_hex_in_production
JWT_EXPIRES_IN=8h

# Dev-only login bypass (remove in production)
DEV_EMAIL=admin@noesis.io
DEV_PASSWORD=CHANGE_ME_before_any_testing
ALLOW_REGISTRATION=false

# ── HIPAA COMPLIANCE ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHI_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_32_bytes_required_for_AES256
AUDIT_LOG_RETENTION_DAYS=2555
ENABLE_AUDIT_LOGGING=true
SESSION_TIMEOUT_MINUTES=30

# ── STRIPE BILLING ────────────────────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# Stripe Price IDs  - create in Stripe dashboard under Products
# Solo Plan  ($299/mo base + metered overage @ $0.45/claim over 500)
STRIPE_PRICE_SOLO_MONTHLY=price_CHANGE_ME_solo_monthly
STRIPE_PRICE_SOLO_ANNUAL=price_CHANGE_ME_solo_annual
STRIPE_PRICE_SOLO_OVERAGE=price_CHANGE_ME_solo_overage_metered

# Group Plan ($799/mo base + metered overage @ $0.30/claim over 2000)
STRIPE_PRICE_GROUP_MONTHLY=price_CHANGE_ME_group_monthly
STRIPE_PRICE_GROUP_ANNUAL=price_CHANGE_ME_group_annual
STRIPE_PRICE_GROUP_OVERAGE=price_CHANGE_ME_group_overage_metered

# ── DATABASE ──────────────────────────────────────────────────────────────────
# PostgreSQL  - required for production, optional for local dev (falls back to in-memory)
# AWS RDS recommended: postgresql://user:pass@hostname:5432/noesis_health?sslmode=require
DATABASE_URL=postgresql://noesis:CHANGE_ME@localhost:5432/noesis_health

# ── REDIS ─────────────────────────────────────────────────────────────────────
# Required for production (rate limiting, session tracking, token blacklist)
# AWS ElastiCache or Redis Cloud recommended
REDIS_URL=redis://localhost:6379

# ── EDI CLEARINGHOUSE ─────────────────────────────────────────────────────────
# Choose one: office_ally | change_healthcare | availity | waystar
CLEARINGHOUSE_PROVIDER=office_ally
CLEARINGHOUSE_API_URL=https://api.officeally.com/v1
CLEARINGHOUSE_API_KEY=CHANGE_ME
CLEARINGHOUSE_API_SECRET=CHANGE_ME
CLEARINGHOUSE_SENDER_ID=NOESIS01

# ── PAYER ELIGIBILITY ─────────────────────────────────────────────────────────
# Availity multi-payer hub (recommended  - covers 2,800+ payers)
# Enroll at: https://developer.availity.com
AVAILITY_CLIENT_ID=CHANGE_ME
AVAILITY_CLIENT_SECRET=CHANGE_ME
AVAILITY_API_URL=https://api.availity.com

# Change Healthcare (alternative  - 4,500+ payers)
CHC_CLIENT_ID=CHANGE_ME
CHC_CLIENT_SECRET=CHANGE_ME
CHC_API_URL=https://api.changehealthcare.com

# ── EHR / FHIR R4 ────────────────────────────────────────────────────────────
# Enroll in EHR partner program before setting these
# Epic:        https://fhir.epic.com/Documentation
# Athenahealth: https://developer.athenahealth.com
# Cerner:      https://code.cerner.com
EHR_PROVIDER=epic
EHR_FHIR_BASE_URL=https://open.epic.com/FHIR/R4
EHR_CLIENT_ID=CHANGE_ME
EHR_CLIENT_SECRET=CHANGE_ME
EHR_TOKEN_URL=https://fhir.epic.com/interconnect-amcurprd-oauth/oauth2/token
EHR_ORGANIZATION_ID=CHANGE_ME

# ── FREE INTEGRATIONS (no keys needed) ───────────────────────────────────────
# NPI Registry: https://npiregistry.cms.hhs.gov/api/     - no key, no rate limit documented
# OpenFDA:      https://api.fda.gov/                     - no key, 40 req/min limit
# OpenFDA API key (optional  - raises limit to 240 req/min):
# OPEN_FDA_API_KEY=CHANGE_ME

# ── EMAIL / NOTIFICATIONS ─────────────────────────────────────────────────────
# SendGrid recommended for HIPAA-compliant transactional email
SENDGRID_API_KEY=CHANGE_ME
FROM_EMAIL=noreply@noesis.io
SALES_EMAIL=sales@athenacoretech.com

# ── LOGGING ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=/var/log/noesis-health.log

# ── ERROR MONITORING (Sentry) ────────────────────────────────────────────────
# Server-side DSN. Provision a project at https://sentry.io/ and paste the DSN
# here in deployment secrets (NEVER commit the real value). If unset, Sentry is
# a safe no-op  - errors still surface via the local logger.
SENTRY_DSN=

# ── PHI ENCRYPTION KEY  - PRODUCTION GUIDANCE ────────────────────────────────
# PHI_ENCRYPTION_KEY: provision via AWS Secrets Manager in production. Local
# dev only here. See HIPAA-COMPLIANCE.md §164.312(a)(2)(iv) for key custody
# requirements. The startup check in server/utils/encryption.js logs a warning
# when NODE_ENV=production and the key is not sourced from Secrets Manager
# (set AWS_SECRETS_MANAGER_KEY_ARN to silence the warning).
# AWS_SECRETS_MANAGER_KEY_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:noesis-health/phi-key

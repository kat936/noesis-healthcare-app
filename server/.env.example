# Noesis.io Health — Environment Configuration
# © 2026 Athena Core Technologies
# NEVER commit actual values. Copy to .env and fill in.

# ============ SERVER ============
PORT=3001
NODE_ENV=development

# ============ AUTHENTICATION (CHANGE IN PRODUCTION) ============
JWT_SECRET=your_random_256_bit_key_here_change_in_production
SESSION_TIMEOUT_MINUTES=60

# ============ STRIPE BILLING ============
# Get these from your Stripe Dashboard
STRIPE_SECRET_KEY=sk_test_CHANGE_ME_in_production
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_in_production
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME_in_production

# ============ DATABASE (Required for production) ============
# PostgreSQL connection string for user data, claims, contracts
DATABASE_URL=postgresql://user:password@localhost:5432/noesis_health

# ============ REDIS (Required for production) ============
# For caching, session management, rate limiting
REDIS_URL=redis://localhost:6379

# ============ EXTERNAL APIs (Free - no keys needed) ============
# NPI Registry: https://npiregistry.cms.hhs.gov/api/ (no key required)
# OpenFDA: https://api.fda.gov/ (no key required, rate limited to 40 req/min)

# ============ HIPAA COMPLIANCE ============
AUDIT_LOG_RETENTION_DAYS=2555
PHI_ENCRYPTION_KEY=your_aes_256_encryption_key_here
ENABLE_AUDIT_LOGGING=true

# ============ EMAIL (Optional for notifications) ============
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key

# ============ LOGGING ============
LOG_LEVEL=info
LOG_FILE=/var/log/noesis-health.log

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ── Push Notifications ───────────────────────────────────────────
         Required for the live notification bell in Noesis Health.
         Capabilities are also enabled in the Apple Developer portal for
         the App ID com.athenacore.noesishealth. -->
    <key>aps-environment</key>
    <string>development</string>

    <!-- ── Associated Domains ───────────────────────────────────────────
         Universal links for password manager autofill and deep linking
         from authenticated emails. Replace the apex domain when DNS
         records are confirmed. -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:noesis.io</string>
        <string>applinks:health.noesis.io</string>
        <string>webcredentials:noesis.io</string>
    </array>

    <!-- ── Keychain Sharing ────────────────────────────────────────────
         Allow the WebView and any future companion targets (widgets,
         App Clips) to share authentication tokens via the secure keychain. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.athenacore.noesishealth</string>
    </array>
</dict>
</plist>

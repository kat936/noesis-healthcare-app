<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ── Bundle Identity ─────────────────────────────────────────────── -->
    <key>CFBundleIdentifier</key>
    <string>com.athenacore.noesishealth</string>

    <key>CFBundleName</key>
    <string>Noesis Health</string>

    <key>CFBundleDisplayName</key>
    <string>Noesis Health</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <!-- ── Deployment ──────────────────────────────────────────────────── -->
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <key>MinimumOSVersion</key>
    <string>16.0</string>

    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer><!-- iPhone -->
        <integer>2</integer><!-- iPad -->
    </array>

    <!-- ── Orientation ────────────────────────────────────────────────── -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- ── App Transport Security ─────────────────────────────────────── -->
    <!-- Only allow HTTPS in transit. Required for HIPAA technical safeguards
         (45 CFR §164.312(e)). The localhost exception below is gated by a
         build configuration; it MUST NOT ship in App Store / TestFlight
         release builds. See ios/App/SUBMISSION.md for the verification step. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <!-- localhost for development only — release builds exclude this
                 dict via build-time Info.plist substitution. -->
            <key>localhost</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
                <key>NSIncludesSubdomains</key>
                <true/>
            </dict>
        </dict>
    </dict>

    <!-- ── Encryption Export Compliance ───────────────────────────────── -->
    <!-- Noesis Health uses only standard HTTPS / TLS encryption that is
         exempt from US Bureau of Industry and Security export licensing
         per ECCN 5D992 license exception ENC. Setting this key avoids the
         App Store Connect export-compliance questionnaire on every build. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- ── Privacy Usage Descriptions ────────────────────────────────── -->
    <!-- Apple REQUIRES these strings for any permission request -->
    <!-- Only include permissions actually used by the app -->

    <key>NSCameraUsageDescription</key>
    <string>Noesis Health uses the camera to scan and upload claim documentation and supporting medical records.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>Noesis Health accesses your photo library to attach supporting documentation for insurance claims and prior authorization requests.</string>

    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Noesis Health saves exported reports and documents to your photo library.</string>

    <key>NSFaceIDUsageDescription</key>
    <string>Noesis Health uses Face ID to securely authenticate you and protect access to sensitive healthcare and insurance data.</string>

    <!-- Local network / Bonjour: required for Capacitor live-reload during
         development and for any future provider-network LAN integration.
         Remove if not needed in your release build. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Noesis Health uses your local network for development tooling and to communicate with on-premises EHR systems where applicable.</string>

    <!-- App Tracking Transparency: Noesis Health does NOT track users
         across apps or websites. The string is supplied in case a future
         analytics provider triggers the prompt; the answer is informational. -->
    <key>NSUserTrackingUsageDescription</key>
    <string>Noesis Health does not track you across apps or websites. This permission is requested only if a future feature requires it.</string>

    <!-- ── Launch Screen ───────────────────────────────────────────────── -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <!-- ── Main Interface ─────────────────────────────────────────────── -->
    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <!-- ── Status Bar ─────────────────────────────────────────────────── -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>

    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- ── Scene Configuration ────────────────────────────────────────── -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                    <key>UISceneStoryboardFile</key>
                    <string>Main</string>
                </dict>
            </array>
        </dict>
    </dict>

    <!-- ── Background Modes ───────────────────────────────────────────── -->
    <!-- Only include if using push notifications -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>

    <!-- ── Healthcare Data Declaration ───────────────────────────────── -->
    <!-- Required for HealthKit integration (add if connecting to HealthKit) -->
    <!--
    <key>NSHealthShareUsageDescription</key>
    <string>Noesis Health may access health records to facilitate insurance claim verification.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Noesis Health does not modify health records.</string>
    -->

</dict>
</plist>
